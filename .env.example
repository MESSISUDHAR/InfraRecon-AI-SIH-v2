# Environment Configuration for InfraRecon AI

# Application
APP_NAME="InfraRecon AI"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default uses local SQLite for instant zero-dependency execution.
# For PostgreSQL with pgvector, use: postgresql://postgres:postgres@localhost:5432/infra_recon
DATABASE_URL=sqlite:///./infra_recon.db

# LLM Configuration (Server-Side Only - Used in Milestone 4)
# GEMINI_API_KEY is kept on the backend and NEVER exposed to frontend
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings (Sentence Transformers - Used in Milestone 5)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Reconciliation Engine Weights (Must sum to 1.0)
WEIGHT_SEMANTIC=0.40
WEIGHT_IDENTIFIER=0.20
WEIGHT_DISCIPLINE=0.15
WEIGHT_LOCATION=0.10
WEIGHT_WBS=0.10
WEIGHT_TEMPORAL=0.05

# Confidence Policy Thresholds
THRESHOLD_HIGH_CONFIDENCE=0.85
THRESHOLD_MEDIUM_CONFIDENCE=0.60

# Frontend URL (for CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
